// 1. configure the database connection to use a local file
datasource db {
  provider = "sqlite"
}

// 2. Generate the Typescript/javascript query client tool
generator client {
  provider = "prisma-client-js"
}

// 3. The user table : stores account credentials
model User {
  id  Int @id @default(autoincrement())
  email String  @unique
  password  String  //This will store a secure, hashed password String
  createdAt DateTime  @default(now())

  // Relationships: A user can have many watchlist items and favorites
  watchlist Watchlist[]
  favorites Favorite[]
}

// 4. The movie Table: Cache mvie data fetched from external APIs 
model Movie {
  id  Int @id //we can use the id provided by the external movie api
  title String
  posterPath  String? //optional field if the movie doesn't have an image
  releaseYear String
  overview  String?

  // Relationships: This movie can appear on mulltiple users' lists
  watchlists Watchlist[]
  favorites Favorite[]

}

// 5. The watchlist join table: Links a user to their saved movies
model Watchlist {
  id  Int @id @default(autoincrement())
  userId  Int
  movieId Int
  addedAt DateTime  @default(now())

  //Define relationships mapping back to the primary tables
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  // Prevents a user from adding the exact same movie to their watchlist twice
  @@unique([userId, movieId])
}

// 6. The favorite join table: links a user to their favorite movies
model Favorite {
  id  Int @id @default(autoincrement())
  userId  Int
  movieId Int
  addedAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}